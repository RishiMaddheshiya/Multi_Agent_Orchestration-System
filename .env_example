# Required
GEMINI_API_KEY="PASTE_YOUR_KEY"

# Model (defaults shown)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_THINKING_LEVEL=low          # optional: minimal | low | medium | high
# GEMINI_TEMPERATURE=0.2

# Retries / orchestration
# LLM_MAX_RETRIES=3
# AGENT_MAX_RETRIES=2
# MAX_REVISIONS=1
# MAX_SUBTASKS=6
# MAX_TOOL_CALLS_PER_SUBTASK=3

# Confidence thresholds (0-100): >=auto continue, >=notify notify, >=approve approve action, below escalate
# CONFIDENCE_AUTO_THRESHOLD=80
# CONFIDENCE_NOTIFY_THRESHOLD=60
# CONFIDENCE_APPROVE_THRESHOLD=40

# Human-in-the-loop defaults (also switchable in the sidebar)
# REQUIRE_PLAN_APPROVAL=false
# REQUIRE_ACTION_APPROVAL=false

# Memory
# MEMORY_ENABLED=true
# MEMORY_TOP_K=5
# MEMORY_MAX_DISTANCE=0.55
# MEMORY_MIN_CONFIDENCE=70

Tools
WEB_SEARCH_ENABLED=true            # Google Search grounding through the Gemini API
MAX_UPLOAD_MB=10

# Optional pricing (USD per 1M tokens). Leave unset to show "Cost unavailable".
# GEMINI_INPUT_PRICE_PER_1M=
# GEMINI_OUTPUT_PRICE_PER_1M=

# LOG_LEVEL=INFO
